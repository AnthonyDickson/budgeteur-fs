<configuration>
  <!-- The format is JsonLogEncoder's. BUDGETEUR_LOG_FILE adds a rolling file
       appender in code (shared/Logging.kt), since this file cannot add one
       conditionally without Janino. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="budgeteur.shared.JsonLogEncoder" />
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
  <logger name="io.netty" level="WARN" />
</configuration>
