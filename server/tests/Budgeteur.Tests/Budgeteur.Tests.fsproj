<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Budgeteur.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Microsoft.NET.Test.Sdk generates the entry point. Do not set GenerateProgramFile to false: without an entry
         point the F# assembly is not initialised and Expecto discovers every [<Tests>] value as null. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Budgeteur/Budgeteur.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TestApp.fs" />
    <Compile Include="TestHttp.fs" />
    <Compile Include="Domain/MoneyTests.fs" />
    <Compile Include="Domain/TagTests.fs" />
    <Compile Include="Domain/AsOfDateTests.fs" />
    <Compile Include="Domain/TransactionTests.fs" />
    <Compile Include="Domain/BalanceSheetItemTests.fs" />
    <Compile Include="Domain/BalanceSheetTests.fs" />
    <Compile Include="Domain/AccountTests.fs" />
    <Compile Include="Domain/RuleTests.fs" />
    <Compile Include="Domain/CategorisationTests.fs" />
    <Compile Include="Domain/IncomeStatementTests.fs" />
    <Compile Include="Domain/ReportingPeriodTests.fs" />
    <Compile Include="Data/BalanceSheetItemCodecTests.fs" />
    <Compile Include="Data/PatternMatchTests.fs" />
    <Compile Include="Account/EndpointTests.fs" />
    <Compile Include="BalanceSheet/EndpointTests.fs" />
    <Compile Include="BalanceSheet/ClosingTests.fs" />
    <Compile Include="Report/ComputeTests.fs" />
    <Compile Include="Report/EndpointTests.fs" />
    <Compile Include="Dashboard/PeriodsTests.fs" />
    <Compile Include="Dashboard/MonthTests.fs" />
    <Compile Include="Dashboard/HistoryTests.fs" />
    <Compile Include="Dashboard/EndpointTests.fs" />
    <Compile Include="AutoTag/ChangesTests.fs" />
    <Compile Include="AutoTag/MatchesTests.fs" />
    <Compile Include="AutoTag/EndpointTests.fs" />
    <Compile Include="QuickTag/EndpointTests.fs" />
    <Compile Include="Import/CsvTests.fs" />
    <Compile Include="Import/StatementTests.fs" />
    <Compile Include="Import/ImportHashTests.fs" />
    <Compile Include="Import/ImportTests.fs" />
    <Compile Include="Import/EndpointTests.fs" />
    <Compile Include="Rule/EndpointTests.fs" />
    <Compile Include="Tag/EndpointTests.fs" />
    <Compile Include="Transaction/SearchTests.fs" />
    <Compile Include="Transaction/EndpointTests.fs" />
    <Compile Include="Transaction/SearchEndpointTests.fs" />
    <Compile Include="Auth/ReturnUrlTests.fs" />
    <Compile Include="TestSupport/ResetUserDataTests.fs" />
    <None Include="Import/Fixtures/*.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="Expecto.FsCheck" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>

</Project>
