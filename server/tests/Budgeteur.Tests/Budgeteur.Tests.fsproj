<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Budgeteur.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Microsoft.NET.Test.Sdk generates the entry point. Do not set GenerateProgramFile to false: without an entry
         point the F# assembly is not initialised and Expecto discovers every [<Tests>] value as null. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Budgeteur/Budgeteur.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TestApp.fs" />
    <Compile Include="TestHttp.fs" />
    <Compile Include="Domain/BalanceSheetItemTests.fs" />
    <Compile Include="Domain/BalanceSheetTests.fs" />
    <Compile Include="Data/BalanceSheetItemTests.fs" />
    <Compile Include="BalanceSheet/EndpointTests.fs" />
    <Compile Include="IncomeStatement/ComputeTests.fs" />
    <Compile Include="IncomeStatement/EndpointTests.fs" />
    <Compile Include="Rules/EndpointTests.fs" />
    <Compile Include="Tags/EndpointTests.fs" />
    <Compile Include="Transactions/EndpointTests.fs" />
    <Compile Include="Transactions/TransactionDescriptionPropertyTests.fs" />
    <Compile Include="TestSupport/ResetUserDataTests.fs" />
    <Compile Include="MoneyTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="Expecto.FsCheck" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>

</Project>
