<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Budgeteur.Server</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ApiError.fs" />
    <Compile Include="DomainError.fs" />
    <Compile Include="RequestLogging.fs" />
    <Compile Include="Coders.fs" />
    <Compile Include="Config.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="OpenApi.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Db.fs" />
    <Compile Include="Endpoint.fs" />
    <Compile Include="Transactions.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="migrations/**/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsToolkit.ErrorHandling" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Oxpecker" />
    <PackageReference Include="Oxpecker.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Thoth.Json.Net" />
    <PackageReference Include="dbup-sqlite" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SqlHydra.Query" />
  </ItemGroup>

</Project>
