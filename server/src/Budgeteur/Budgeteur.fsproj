<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Budgeteur</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- No culture-specific behaviour: formatting uses the invariant culture and
         comparisons are ordinal. Dropping ICU keeps it out of the image. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Budgeteur.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Shared/ApiError.fs" />
    <Compile Include="Shared/DomainError.fs" />
    <Compile Include="Shared/RequestLogging.fs" />
    <Compile Include="Shared/Coders.fs" />
    <Compile Include="Shared/Config.fs" />
    <Compile Include="Shared/Clock.fs" />
    <Compile Include="Shared/Logging.fs" />
    <Compile Include="Shared/Auth.fs" />
    <Compile Include="Shared/OpenApi.fs" />
    <Compile Include="Shared/Json.fs" />
    <Compile Include="Shared/Endpoint.fs" />

    <Compile Include="Domain/Money.fs" />
    <Compile Include="Domain/AsOfDate.fs" />
    <Compile Include="Domain/CloseDate.fs" />
    <Compile Include="Domain/Term.fs" />
    <Compile Include="Domain/Side.fs" />
    <Compile Include="Domain/Tag.fs" />
    <Compile Include="Domain/Transaction.fs" />
    <Compile Include="Domain/Rule.fs" />
    <Compile Include="Domain/Categorisation.fs" />
    <Compile Include="Domain/BalanceSheetItem.fs" />
    <Compile Include="Domain/Account.fs" />
    <Compile Include="Domain/BalanceSheet.fs" />
    <Compile Include="Domain/IncomeStatement.fs" />
    <Compile Include="Domain/ReportingPeriod.fs" />

    <Compile Include="Data/Db.fs" />
    <Compile Include="Data/Constraints.fs" />
    <Compile Include="Data/RuleCodec.fs" />
    <Compile Include="Data/TagCodec.fs" />
    <Compile Include="Data/CategorisationCodec.fs" />
    <Compile Include="Data/CategorisationStore.fs" />
    <Compile Include="Data/TransactionCodec.fs" />
    <Compile Include="Data/BalanceSheetItemCodec.fs" />
    <Compile Include="Data/ItemObservationCodec.fs" />
    <Compile Include="Data/ItemValueCodec.fs" />
    <Compile Include="Data/ItemObservationStore.fs" />
    <Compile Include="Data/AccountCodec.fs" />
    <Compile Include="Data/BalanceObservationCodec.fs" />
    <Compile Include="Data/BalanceObservationStore.fs" />
    <Compile Include="Data/AccountBalanceCodec.fs" />
    <Compile Include="Data/IncomeStatementQuery.fs" />
    <Compile Include="Data/BalanceSheetHistoryQuery.fs" />
    <Compile Include="Data/TransactionsAfterCloseQuery.fs" />
    <Compile Include="Data/PatternMatch.fs" />

    <Compile Include="Feature/Auth/ReturnUrl.fs" />
    <Compile Include="Feature/Auth/Login.fs" />
    <Compile Include="Feature/Auth/Logout.fs" />

    <Compile Include="Feature/BalanceSheet/ItemRequest.fs" />
    <Compile Include="Feature/BalanceSheet/BalanceSheetItemResponse.fs" />
    <Compile Include="Feature/BalanceSheet/AccountLineResponse.fs" />
    <Compile Include="Feature/BalanceSheet/ItemQuery.fs" />
    <Compile Include="Feature/BalanceSheet/ReadBalanceSheet.fs" />
    <Compile Include="Feature/BalanceSheet/CreateBalanceSheetItem.fs" />
    <Compile Include="Feature/BalanceSheet/ReadBalanceSheetItem.fs" />
    <Compile Include="Feature/BalanceSheet/ReadAllBalanceSheetItems.fs" />
    <Compile Include="Feature/BalanceSheet/UpdateBalanceSheetItem.fs" />
    <Compile Include="Feature/BalanceSheet/CloseBalanceSheetItem.fs" />
    <Compile Include="Feature/BalanceSheet/ReopenBalanceSheetItem.fs" />
    <Compile Include="Feature/BalanceSheet/RecordItemObservation.fs" />
    <Compile Include="Feature/BalanceSheet/ReadItemObservations.fs" />
    <Compile Include="Feature/BalanceSheet/DeleteItemObservation.fs" />
    <Compile Include="Feature/BalanceSheet/DeleteBalanceSheetItem.fs" />
    <Compile Include="Feature/BalanceSheet/BalanceSheetEndpoints.fs" />

    <Compile Include="Feature/Account/AccountRequest.fs" />
    <Compile Include="Feature/Account/AccountResponse.fs" />
    <Compile Include="Feature/Account/AccountQuery.fs" />
    <Compile Include="Feature/Account/CreateAccount.fs" />
    <Compile Include="Feature/Account/ReadAccount.fs" />
    <Compile Include="Feature/Account/ReadAllAccounts.fs" />
    <Compile Include="Feature/Account/UpdateAccount.fs" />
    <Compile Include="Feature/Account/CloseAccount.fs" />
    <Compile Include="Feature/Account/ReopenAccount.fs" />
    <Compile Include="Feature/Account/RecordBalance.fs" />
    <Compile Include="Feature/Account/ReadBalanceObservations.fs" />
    <Compile Include="Feature/Account/DeleteBalanceObservation.fs" />
    <Compile Include="Feature/Account/DeleteAccount.fs" />
    <Compile Include="Feature/Account/AccountEndpoints.fs" />

    <Compile Include="Feature/Tag/TagResponse.fs" />
    <Compile Include="Feature/Tag/CreateTag.fs" />
    <Compile Include="Feature/Tag/ReadTag.fs" />
    <Compile Include="Feature/Tag/ReadAllTags.fs" />
    <Compile Include="Feature/Tag/UpdateTag.fs" />
    <Compile Include="Feature/Tag/DeleteTag.fs" />
    <Compile Include="Feature/Tag/TagEndpoints.fs" />

    <Compile Include="Feature/Rule/RuleResponse.fs" />
    <Compile Include="Feature/Rule/CreateRule.fs" />
    <Compile Include="Feature/Rule/ReadRule.fs" />
    <Compile Include="Feature/Rule/ReadAllRules.fs" />
    <Compile Include="Feature/Rule/UpdateRule.fs" />
    <Compile Include="Feature/Rule/DeleteRule.fs" />
    <Compile Include="Feature/Rule/RuleEndpoints.fs" />

    <Compile Include="Feature/Transaction/TransactionResponse.fs" />
    <Compile Include="Feature/Transaction/TransactionSearch.fs" />
    <Compile Include="Feature/Transaction/TransactionQuery.fs" />
    <Compile Include="Feature/Transaction/CreateTransaction.fs" />
    <Compile Include="Feature/Transaction/ReadTransaction.fs" />
    <Compile Include="Feature/Transaction/ReadAllTransactions.fs" />
    <Compile Include="Feature/Transaction/SearchTransactions.fs" />
    <Compile Include="Feature/Transaction/UpdateTransaction.fs" />
    <Compile Include="Feature/Transaction/DeleteTransaction.fs" />
    <Compile Include="Feature/Transaction/TransactionEndpoints.fs" />

    <Compile Include="Feature/Report/Report.fs" />
    <Compile Include="Feature/Report/ReadReport.fs" />
    <Compile Include="Feature/Report/ReportEndpoints.fs" />
    <Compile Include="Feature/Dashboard/Dashboard.fs" />
    <Compile Include="Feature/Dashboard/ReadDashboard.fs" />
    <Compile Include="Feature/Dashboard/DashboardEndpoints.fs" />

    <Compile Include="Feature/AutoTag/AutoTag.fs" />
    <Compile Include="Feature/AutoTag/RunAutoTag.fs" />
    <Compile Include="Feature/AutoTag/ReadMatches.fs" />
    <Compile Include="Feature/AutoTag/AutoTagEndpoints.fs" />

    <Compile Include="Feature/QuickTag/Suggestion.fs" />
    <Compile Include="Feature/QuickTag/ReadQueue.fs" />
    <Compile Include="Feature/QuickTag/QuickTagWrite.fs" />
    <Compile Include="Feature/QuickTag/QuickTagTransaction.fs" />
    <Compile Include="Feature/QuickTag/DismissTransaction.fs" />
    <Compile Include="Feature/QuickTag/MarkTransfer.fs" />
    <Compile Include="Feature/QuickTag/ApproveSuggestion.fs" />
    <Compile Include="Feature/QuickTag/QuickTagEndpoints.fs" />

    <Compile Include="Feature/Import/Csv.fs" />
    <Compile Include="Feature/Import/Format.fs" />
    <Compile Include="Feature/Import/ImportHash.fs" />
    <Compile Include="Feature/Import/Statement.fs" />
    <Compile Include="Feature/Import/Import.fs" />
    <Compile Include="Feature/Import/ImportStatements.fs" />
    <Compile Include="Feature/Import/ImportEndpoints.fs" />

    <Compile Include="Feature/Status/GetStatus.fs" />

    <Compile Include="Feature/TestSupport/ResetUserData.fs" />

    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/Migrations/**/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsToolkit.ErrorHandling" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Oxpecker" />
    <PackageReference Include="Oxpecker.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Thoth.Json.Net" />
    <PackageReference Include="dbup-sqlite" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SqlHydra.Query" />
  </ItemGroup>

</Project>
