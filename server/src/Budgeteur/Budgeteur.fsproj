<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Budgeteur</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Shared/ApiError.fs" />
    <Compile Include="Shared/DomainError.fs" />
    <Compile Include="Shared/RequestLogging.fs" />
    <Compile Include="Shared/Coders.fs" />
    <Compile Include="Shared/Config.fs" />
    <Compile Include="Shared/Auth.fs" />
    <Compile Include="Shared/OpenApi.fs" />
    <Compile Include="Shared/Json.fs" />
    <Compile Include="Shared/Endpoint.fs" />
    <Compile Include="Shared/Money.fs" />

    <Compile Include="Domain/Tag.fs" />
    <Compile Include="Domain/Transaction.fs" />
    <Compile Include="Domain/Rule.fs" />

    <Compile Include="Data/Db.fs" />
    <Compile Include="Data/Constraints.fs" />
    <Compile Include="Data/RuleCodec.fs" />
    <Compile Include="Data/TagCodec.fs" />

    <Compile Include="Feature/Auth/Login.fs" />
    <Compile Include="Feature/Auth/Logout.fs" />

    <Compile Include="Feature/Tag/TagResponse.fs" />
    <Compile Include="Feature/Tag/CreateTag.fs" />
    <Compile Include="Feature/Tag/ReadTag.fs" />
    <Compile Include="Feature/Tag/ReadAllTags.fs" />
    <Compile Include="Feature/Tag/UpdateTag.fs" />
    <Compile Include="Feature/Tag/DeleteTag.fs" />

    <Compile Include="Feature/Rule/RuleResponse.fs" />
    <Compile Include="Feature/Rule/CreateRule.fs" />
    <Compile Include="Feature/Rule/ReadRule.fs" />
    <Compile Include="Feature/Rule/ReadAllRules.fs" />
    <Compile Include="Feature/Rule/UpdateRule.fs" />
    <Compile Include="Feature/Rule/DeleteRule.fs" />

    <Compile Include="Feature/Transaction/TransactionCodec.fs" />
    <Compile Include="Feature/Transaction/TransactionResponse.fs" />
    <Compile Include="Feature/Transaction/CreateTransaction.fs" />
    <Compile Include="Feature/Transaction/ReadTransaction.fs" />
    <Compile Include="Feature/Transaction/ReadAllTransactions.fs" />
    <Compile Include="Feature/Transaction/UpdateTransaction.fs" />
    <Compile Include="Feature/Transaction/DeleteTransaction.fs" />

    <Compile Include="Feature/GetStatus.fs" />

    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/Migrations/**/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsToolkit.ErrorHandling" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Oxpecker" />
    <PackageReference Include="Oxpecker.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Thoth.Json.Net" />
    <PackageReference Include="dbup-sqlite" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SqlHydra.Query" />
  </ItemGroup>

</Project>
