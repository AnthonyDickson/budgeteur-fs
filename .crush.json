{
  "$schema": "https://charm.land/crush.json",
  "lsp": {
    "gleam": {
      "command": "sh",
      "args": ["-c", "cd client && gleam lsp"],
      "root_markers": ["client/gleam.toml"]
    },
    "fsharp": {
      "command": "sh",
      "args": ["-c", "cd server && dotnet tool run fsautocomplete"],
      "root_markers": ["server/Budgeteur.slnx"]
    },
    "kotlin": {
      "command": "sh",
      "args": ["-c", "cd server-kt && kotlin-lsp --stdio"],
      "root_markers": ["server-kt/settings.gradle.kts"]
    }
  }
}
