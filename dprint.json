{
  "markdown": {
    "lineWidth": 80,
    "textWrap": "always"
  },
  "typescript": {
    "lineWidth": 80,
    "quoteStyle": "preferSingle"
  },
  "dockerfile": {
    "associations": ["**/Dockerfile", "**/Dockerfile.*"]
  },
  "excludes": [
    "**/package-lock.json",
    "client/manifest.toml"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.24.0.wasm",
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    "https://plugins.dprint.dev/toml-0.9.0.wasm",
    "https://plugins.dprint.dev/dockerfile-0.7.0.wasm"
  ]
}
